# =====================================================================
# Tribuna Socialista — variáveis de ambiente
#
# Copie este arquivo para .env.local (desenvolvimento) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# NUNCA coloque estes valores no código nem no GitHub.
# =====================================================================

# URL do projeto no Supabase.
# Onde encontrar: Supabase → Project Settings → API → "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (publishable / anon) do Supabase.
# Onde encontrar: Supabase → Project Settings → API Keys → "Publishable key"
# (começa com sb_publishable_). Em projetos antigos, use a "anon public key".
# É segura no navegador: o que cada pessoa pode ver ou mudar é decidido pelas
# regras de segurança (RLS) do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Endereço público do site, sem barra no final.
# Local: http://localhost:3000   Produção: https://www.seudominio.com.br
# Usado em links de compartilhamento, RSS, sitemap e dados para o Google.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opcional) Fuso horário do jornal, para datas e horários. Padrão: America/Maceio
# NEXT_PUBLIC_TIMEZONE=America/Maceio

# ---------------------------------------------------------------------
# Assinaturas por e-mail (resumo semanal) — Resend + Vercel Cron
# ---------------------------------------------------------------------
# Chave SECRETA do Supabase (só no servidor; nunca no navegador).
# Onde encontrar: Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...).
SUPABASE_SECRET_KEY=

# Chave da API do Resend (re_...). Resend → API Keys.
RESEND_API_KEY=
# ID do segmento que recebe o resumo. Resend → Audience → Segments.
RESEND_SEGMENT_ID=
# Remetente (domínio verificado no Resend).
NEWSLETTER_FROM=Tribuna Socialista <assinaturas@tribunasocialista.com.br>
# (Opcional) endereço para respostas dos leitores.
NEWSLETTER_REPLY_TO=
# Senha da rotina semanal (qualquer texto longo e aleatório). A Vercel a envia
# automaticamente ao acionar /api/cron/resumo-semanal e /api/cron/instagram.
# (O aviso dos agendados, /api/cron/agendados, usa a senha do Vault do
# Supabase, tribuna_cron_secret, conferida no próprio banco.)
CRON_SECRET=
